{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Visual Studio x64 Debug build",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "description": "Visual Studio x64 Release build",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Ninja Debug",
      "description": "Ninja x64 Debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Ninja Release",
      "description": "Ninja x64 Release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Ninja Debug",
      "configurePreset": "windows-ninja-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows Ninja Release",
      "configurePreset": "windows-ninja-release",
      "configuration": "Release"
    }
  ]
}
